@article{cameron2008bootstrap,
  author       = {Cameron, A. Colin and Gelbach, Jonah B. and Miller, Douglas L.},
  title        = {Bootstrap-based improvements for inference with clustered errors},
  journaltitle = {The Review of Economics and Statistics},
  volume       = {90},
  number       = {3},
  pages        = {414--427},
  year         = {2008},
  doi          = {10.1162/rest.90.3.414}
}
% nota: Referencia fundamental para bootstrap clusterizado (wild cluster bootstrap) con pocos clusters. Justifica el uso de wild bootstrap Rademacher para inferencia válida cuando el número de clusters es pequeño (G < 50). En este proyecto se aplica con 77 centros, 2000 iteraciones.

@article{bertrand2004much,
  author       = {Bertrand, Marianne and Duflo, Esther and Mullainathan, Sendhil},
  title        = {How much should we trust differences-in-differences estimates?},
  journaltitle = {The Quarterly Journal of Economics},
  volume       = {119},
  number       = {1},
  pages        = {249--275},
  year         = {2004},
  doi          = {10.1162/003355304772839588}
}
% nota: Referencia clásica sobre inferencia con datos de panel y errores clusterizados. Demuestra que los errores estándar convencionales pueden subestimar drásticamente la varianza en presencia de autocorrelación serial, y recomienda clustering o bootstrap. En este proyecto se cita como fundamento metodológico para el uso de cluster-robust inference y wild/pairs cluster bootstrap en modelos de panel (Fase 3b, 4b, 6).

@article{cameron2011robust,
  author       = {Cameron, A. Colin and Gelbach, Jonah B. and Miller, Douglas L.},
  title        = {Robust inference with multiway clustering},
  journaltitle = {Journal of Business \& Economic Statistics},
  volume       = {29},
  number       = {2},
  pages        = {238--249},
  year         = {2011},
  doi          = {10.1198/jbes.2010.07136}
}
% nota: Referencia metodológica para inferencia con clustering multiway (múltiples dimensiones de correlación simultánea). Justifica el uso de errores estándar multiway clusterizados por center_id × meal_id en el modelo OLS principal. En este proyecto la estructura de datos tiene correlación tanto dentro de centro como dentro de comida.

@article{cameron2015practitioner,
  author       = {Cameron, A. Colin and Miller, Douglas L.},
  title        = {A practitioner's guide to cluster-robust inference},
  journaltitle = {Journal of Human Resources},
  volume       = {50},
  number       = {2},
  pages        = {317--372},
  year         = {2015},
  doi          = {10.3368/jhr.50.2.317}
}
% nota: Referencia metodológica fundamental para la inferencia con errores correlacionados dentro de grupos. Justifica el uso de errores estándar clusterizados y discute extensiones relevantes para este proyecto, incluyendo efectos fijos, pocos clusters y clustering en múltiples dimensiones. Su aplicación aquí debe adaptarse a la estructura panel centro × comida × semana, evitando asumir independencia dentro de cada dimensión.

@article{wooldridge2015control,
  author       = {Wooldridge, Jeffrey M.},
  title        = {Control function methods in applied econometrics},
  journaltitle = {Journal of Human Resources},
  volume       = {50},
  number       = {2},
  pages        = {420--445},
  year         = {2015},
  doi          = {10.3368/jhr.50.2.420}
}
% nota: Referencia central para el enfoque de Función de Control (CF) aplicado a variables explicativas endógenas en modelos lineales y no lineales. Proporciona el fundamento teórico para incorporar un residuo de primera etapa como control de la componente endógena y para estudiar efectos parciales bajo supuestos de identificación. En este proyecto respalda el uso del CF como análisis de sensibilidad para combinar endogeneidad y una forma funcional no lineal, pero no garantiza por sí mismo la validez de los instrumentos ni sustituye la justificación de la restricción de exclusión.

@article{hausman1978specification,
  author       = {Hausman, Jerry A.},
  title        = {Specification tests in econometrics},
  journaltitle = {Econometrica},
  volume       = {46},
  number       = {6},
  pages        = {1251--1271},
  year         = {1978},
  doi          = {10.2307/1913827}
}
% nota: Trabajo seminal sobre pruebas de especificación basadas en la comparación de estimadores con distintas propiedades de consistencia y eficiencia bajo la hipótesis nula. Fundamenta la familia de pruebas de Hausman utilizadas posteriormente en econometría, incluida su aplicación clásica a la comparación entre efectos fijos y efectos aleatorios en datos de panel. En este proyecto debe citarse como fundamento general del enfoque de especificación, sin interpretarlo por sí solo como una prueba de validez de los instrumentos IV.

@article{nevo2001measuring,
  author       = {Nevo, Aviv},
  title        = {Measuring market power in the ready-to-eat cereal industry},
  journaltitle = {Econometrica},
  volume       = {69},
  number       = {2},
  pages        = {307--342},
  year         = {2001},
  doi          = {10.1111/1468-0262.00194}
}
% nota: Referencia empírica fundamental para la estimación de demanda de productos diferenciados con precios potencialmente endógenos. Nevo desarrolla un modelo de coeficientes aleatorios y utiliza variables instrumentales para identificar la respuesta de la demanda al precio y estudiar el poder de mercado. En este proyecto sirve como antecedente para la estrategia IV en demanda diferenciada, pero no valida automáticamente los instrumentos construidos a partir de precios de otros centros ni su restricción de exclusión.

@incollection{stock2005testing,
  author       = {Stock, James H. and Yogo, Motohiro},
  title        = {Testing for weak instruments in linear IV regression},
  booktitle    = {Identification and inference for econometric models: Essays in honor of Thomas Rothenberg},
  publisher    = {Cambridge University Press},
  address      = {Cambridge},
  pages        = {80--108},
  year         = {2005},
  doi          = {10.1017/CBO9780511614491.006}
}
% nota: Referencia fundamental para evaluar la debilidad de los instrumentos en modelos IV. Stock y Yogo muestran que instrumentos débilmente correlacionados con el regresor endógeno pueden producir sesgos importantes y distorsiones en la inferencia convencional, y proporcionan valores críticos basados en criterios de sesgo relativo y tamaño de los tests. En este proyecto se utiliza como fundamento para evaluar la relevancia de los instrumentos, evitando interpretar F > 10 como una regla universal; la evaluación definitiva debe considerar el estadístico apropiado y el contexto de inferencia.

@article{ramsey1969tests,
author    = {Ramsey, James B.},
title     = {Tests for specification errors in classical linear least-squares regression analysis},
journal   = {Journal of the Royal Statistical Society: Series B (Methodological)},
volume    = {31},
number    = {2},
pages     = {350--371},
year      = {1969},
doi       = {10.1111/j.2517-6161.1969.tb00796.x},
url       = {https://doi.org/10.1111/j.2517-6161.1969.tb00796.x}
}
% nota: Trabajo seminal sobre pruebas de errores de especificación en modelos de mínimos cuadrados y fundamento original de la familia de pruebas RESET. El enfoque evalúa evidencia compatible con errores de especificación, incluyendo forma funcional incorrecta y variables omitidas, entre otros problemas. En este proyecto el RESET se utiliza como diagnóstico de especificación funcional y no como prueba causal ni como evidencia aislada de una variable omitida concreta.

